# Entity: book

main: kit: entity: book: {

  alias: field: {}

  fields: [
    {
      name: "id"
      req: false
      short: "Unique identifier for the book"
      type: "`$INTEGER`"
    }
    {
      name: "isbn"
      req: false
      short: "ISBN of the book"
      type: "`$STRING`"
    }
    {
      name: "pages"
      req: false
      short: "Number of pages"
      type: "`$INTEGER`"
    }
    {
      name: "publisher"
      req: false
      short: "Publisher of the book"
      type: "`$STRING`"
    }
    {
      name: "title"
      req: false
      short: "Title of the book"
      type: "`$STRING`"
    }
    {
      name: "year"
      req: false
      short: "Year of publication"
      type: "`$INTEGER`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "book"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/api/books"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "books"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                example: 19
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/api/book/{id}"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "book"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
