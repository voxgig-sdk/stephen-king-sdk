# Entity: villain

main: kit: entity: villain: {

  alias: field: {}

  fields: [
    {
      name: "gender"
      req: false
      short: "Gender of the villain"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      short: "Unique identifier for the villain"
      type: "`$INTEGER`"
    }
    {
      name: "name"
      req: false
      short: "Name of the villain"
      type: "`$STRING`"
    }
    {
      name: "notes"
      req: false
      short: "Additional notes about the villain"
      type: "`$STRING`"
    }
    {
      name: "status"
      req: false
      short: "Current status of the villain"
      type: "`$STRING`"
    }
    {
      name: "work"
      req: false
      short: "Book or story the villain appears in"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "villain"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/api/villains"
          parts: [
            "api"
            "villains"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                example: 19
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/api/villain/{id}"
          parts: [
            "api"
            "villain"
            "{id}"
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
